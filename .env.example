# Copy to .env (main station) or stations/<shortcode>.env (status boards).
# Placeholders only; never commit the real files. .env is NOT copied into the
# Docker image; settings reach the container through compose `env_file`.

# ---- Main station only -------------------------------------------------
# Discord webhook for the main now-playing channel. A status-board container
# must NOT be given the main .env: it would post to the main channel.
NOW_PLAYING_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ---- Status-board containers only (stations/<shortcode>.env) -----------
# Set STATUS_BOARD to a true value (1/true/yes) to run as a status board.
STATUS_BOARD=
# Webhook for that station's status-board channel (use instead of NOW_PLAYING_WEBHOOK).
STATUS_BOARD_WEBHOOK=
# Which station to watch (defaults: spiral.radio / radiospiral).
STATION_SERVER=
STATION_SHORTCODE=
# Display name (defaults to the shortcode).
STATION_NAME=
# Name AzuraCast reports for AutoDJ streamers.
AUTODJ_NAME=

# ---- Any container -----------------------------------------------------
# Directory for state files (default: current directory).
STATE_DIR=
# Seconds to wait on a Discord webhook call (default 10).
WEBHOOK_TIMEOUT=
# Seconds of SSE silence before reconnecting (default 300).
SSE_READ_TIMEOUT=
# True value: log what would be posted instead of posting.
DRY_RUN=

# Optional: Bot token (not currently used, but reserved for future features)
BOT_TOKEN=your_bot_token_here

# Debugging
# Set to any non-empty value to enable SSE metadata logging
AZ_CLIENT_DEBUG=

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
